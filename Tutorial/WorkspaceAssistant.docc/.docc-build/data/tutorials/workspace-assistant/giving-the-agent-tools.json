icle","type":"topic"},"wa-agent.png":{"type":"image","alt":"A chat with an AI agent showing the actions it took.","identifier":"wa-agent.png","variants":[{"traits":["1x","light"],"url":"\/images\/au.edu.uts.WorkspaceAssistant.tutorial\/wa-agent.png"}]},"wa-diagram-tool.png":{"type":"image","alt":"The parts of a tool: name and description, arguments, and call.","identifier":"wa-diagram-tool.png","variants":[{"traits":["1x","light"],"url":"\/images\/au.edu.uts.WorkspaceAssistant.tutorial\/wa-diagram-tool.png"}]},"doc://au.edu.uts.WorkspaceAssistant.tutorial/tutorials/Workspace-Assistant/Talking-to-the-Agent#Run-the-Agentic-Loop":{"abstract":[{"text":"Create a ","type":"text"},{"code":"LanguageModelSession","type":"codeVoice"},{"text":" with the tools, send it the user’s request, and show each tool call in a chat while the board changes behind it.","type":"text"}],"url":"\/tutorials\/workspace-assistant\/talking-to-the-agent#Run-the-Agentic-Loop","identifier":"doc:\/\/au.edu.uts.WorkspaceAssistant.tutorial\/tutorials\/Workspace-Assistant\/Talking-to-the-Agent#Run-the-Agentic-Loop","title":"Run the Agentic Loop","kind":"section","role":"pseudoSymbol","type":"section"},"doc://au.edu.uts.WorkspaceAssistant.tutorial/tutorials/Workspace-Assistant/Your-First-Tool#Write-and-Register-the-Tool":{"abstract":[{"text":"Teach the agent something new: removing high priority from a task. You’ll follow the same three steps every tool needs: a command, a tool, and registering it.","type":"text"}],"url":"\/tutorials\/workspace-assistant\/your-first-tool#Write-and-Register-the-Tool","identifier":"doc:\/\/au.edu.uts.WorkspaceAssistant.tutorial\/tutorials\/Workspace-Assistant\/Your-First-Tool#Write-and-Register-the-Tool","title":"Write and Register the Tool","kind":"section","role":"pseudoSymbol","type":"section"},"doc://au.edu.uts.WorkspaceAssistant.tutorial/tutorials/Workspace-Assistant/Modelling-the-Board#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/au.edu.uts.WorkspaceAssistant.tutorial\/tutorials\/Workspace-Assistant\/Modelling-the-Board#Check-Your-Understanding","url":"\/tutorials\/workspace-assistant\/modelling-the-board#Check-Your-Understanding"},"wa-03-tools-01.swift":{"content":["import FoundationModels","","\/\/ The agent's four tools.","\/\/","\/\/ A tool is a function the model may decide to call. You give it:","\/\/   • a name and a description  → how the model knows WHEN to use it","\/\/   • @Generable Arguments      → what the model must fill in (it can't invent other fields)","\/\/   • call(arguments:)          → your Swift code, which returns what really happened","\/\/","\/\/ Each tool here is a thin adapter over one Workspace command.","","struct AddTaskTool: Tool {","    let name = \"addTask\"","    let description = \"Adds a new task to the board.\"","    let workspace: Workspace","","    @Generable","    struct Arguments {","        @Guide(description: \"A short task title in Title Case, e.g. 'Review Pull Requests'\")","        var title: String","        var category: TaskCategory","        @Guide(description: \"True only if the user says the task is important, urgent or high priority\")","        var highPriority: Bool","    }","","    func call(arguments: Arguments) async throws -> String {","        await workspace.addTask(title: arguments.title, category: arguments.category, highPriority: arguments.highPriority, by: .agent)","    }","}"],"fileType":"swift","syntax":"swift","identifier":"wa-03-tools-01.swift","fileName":"Tools.swift","highlights":[],"type":"file"},"doc://au.edu.uts.WorkspaceAssistant.tutorial/tutorials/Workspace-Assistant/Drawing-the-Board#Lay-Out-the-Board":{"abstract":[{"text":"Draw the board in SwiftUI. Because the views only read ","type":"text"},{"code":"Workspace","type":"codeVoice"},{"text":", every change, whether from a tap or from the agent, animates in by itself.","type":"text"}],"url":"\/tutorials\/workspace-assistant\/drawing-the-board#Lay-Out-the-Board","identifier":"doc:\/\/au.edu.uts.WorkspaceAssistant.tutorial\/tutorials\/Workspace-Assistant\/Drawing-the-Board#Lay-Out-the-Board","title":"Lay Out the Board","kind":"section","role":"pseudoSymbol","type":"section"},"wa-03-tools-02.swift":{"content":["import FoundationModels","","\/\/ The agent's four tools.","\/\/","\/\/ A tool is a function the model may decide to call. You give it:","\/\/   • a name and a description  → how the model knows WHEN to use it","\/\/   • @Generable Arguments      → what the model must fill in (it can't invent other fields)","\/\/   • call(arguments:)          → your Swift code, which returns what really happened","\/\/","\/\/ Each tool here is a thin adapter over one Workspace command.","","struct AddTaskTool: Tool {","    let name = \"addTask\"","    let description = \"Adds a new task to the board.\"","    let workspace: Workspace","","    @Generable","    struct Arguments {","        @Guide(description: \"A short task title in Title Case, e.g. 'Review Pull Requests'\")","        var title: String","        var category: TaskCategory","        @Guide(description: \"True only if the user says the task is important, urgent or high priority\")","        var highPriority: Bool","    }","","    func call(arguments: Arguments) async throws -> String {","        await workspace.addTask(title: arguments.title, category: arguments.category, highPriority: arguments.highPriority, by: .agent)","    }","}","","struct CompleteTaskTool: Tool {","    let name = \"completeTask\"","    let description = \"Marks an existing task as done.\"","    let workspace: Workspace","","    @Generable","    struct Arguments {","        @Guide(description: \"The user's words for the task, e.g. 'unit tests'\")","        var task: String","    }","","    func call(arguments: Arguments) async throws -> String {","        await workspace.completeTask(arguments.task)","    }","}"],"fileType":"swift","syntax":"swift","identifier":"wa-03-tools-02.swift","fileName":"Tools.swift","highlights":[{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45}],"type":"file"},"doc://au.edu.uts.WorkspaceAssistant.tutorial/tutorials/Workspace-Assistant/Drawing-the-Board#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/au.edu.uts.WorkspaceAssistant.tutorial\/tutorials\/Workspace-Assistant\/Drawing-the-Board#Check-Your-Understanding","url":"\/tutorials\/workspace-assistant\/drawing-the-board#Check-Your-Understanding"},"wa-03-tools-04.swift":{"content":["import FoundationModels","","\/\/ The agent's four tools.","\/\/","\/\/ A tool is a function the model may decide to call. You give it:","\/\/   • a name and a description  → how the model knows WHEN to use it","\/\/   • @Generable Arguments      → what the model must fill in (it can't invent other fields)","\/\/   • call(arguments:)          → your Swift code, which returns what really happened","\/\/","\/\/ Each tool here is a thin adapter over one Workspace command.","","struct AddTaskTool: Tool {","    let name = \"addTask\"","    let description = \"Adds a new task to the board.\"","    let workspace: Workspace","","    @Generable","    struct Arguments {","        @Guide(description: \"A short task title in Title Case, e.g. 'Review Pull Requests'\")","        var title: String","        var category: TaskCategory","        @Guide(description: \"True only if the user says the task is important, urgent or high priority\")","        var highPriority: Bool","    }","","    func call(arguments: Arguments) async throws -> String {","        await workspace.addTask(title: arguments.title, category: arguments.category, highPriority: arguments.highPriority, by: .agent)","    }","}","","struct CompleteTaskTool: Tool {","    let name = \"completeTask\"","    let description = \"Marks an existing task as done.\"","    let workspace: Workspace","","    @Generable","    struct Arguments {","        @Guide(description: \"The user's words for the task, e.g. 'unit tests'\")","        var task: String","    }","","    func call(arguments: Arguments) async throws -> String {","        await workspace.completeTask(arguments.task)","    }","}","","struct PrioritizeTaskTool: Tool {","    let name = \"prioritizeTask\"","    let description = \"Marks an existing task as high priority so it moves to the top.\"","    let workspace: Workspace","","    @Generable","    struct Arguments {","        @Guide(description: \"The user's words for the task, e.g. 'memory leak'\")","        var task: String","    }","","    func call(arguments: Arguments) async throws -> String {","        await workspace.prioritizeTask(arguments.task)","    }","}","","struct SwitchLayoutTool: Tool {","    let name = \"switchLayout\"","    let description = \"Changes how the board looks: grid of tiles, list of rows, or board with Priority \/ To Do \/ Done columns.\"","    let workspace: Workspace","","    @Generable","    struct Arguments {","        var layout: BoardLayout","    }","","    func call(arguments: Arguments) async throws -> String {","        await workspace.switchLayout(to: arguments.layout, by: .agent)","    }","}","","\/\/ 🧪 LAB: add a DeprioritizeTaskTool here, then register it in TaskAgent.makeSession()."],"fileType":"swift","syntax":"swift","identifier":"wa-03-tools-04.swift","fileName":"Tools.swift","highlights":[{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68},{"line":69},{"line":70},{"line":71},{"line":72},{"line":73},{"line":74},{"line":75},{"line":76},{"line":77},{"line":78}],"type":"file"},"doc://au.edu.uts.WorkspaceAssistant.tutorial/tutorials/Workspace-Assistant/Modelling-the-Board#Let-the-Agent-Name-Tasks-in-I