@Tutorial(time: 25, projectFiles: WorkspaceAssistant.zip) {
    @Intro(title: "Talking to the Agent") {
        Create a `LanguageModelSession` with the tools, send it the user's request, and show each tool call in a chat while the board changes behind it.

        @Image(source: "wa-agent.png", alt: "A chat with an AI agent showing the actions it took.")
    }

    @Section(title: "Create the Session") {
        @ContentAndMedia {
            `TaskAgent` owns one on-device `LanguageModelSession`. The session holds the tools, the instructions and the conversation so far.

            @Image(source: "wa-diagram-session.png", alt: "Instructions and tools go into one on-device session.")
        }

        @Steps {
            @Step {
                Create `TaskAgent.swift`. `makeSession` registers the four tools and writes the instructions, including the tasks on the board, so the model knows their names.

                @Code(name: "TaskAgent.swift", file: wa-04-taskagent-01.swift)
            }

            @Step {
                Add `newConversation` and `prewarm`, plus `unavailableReason`. It checks `SystemLanguageModel.default.availability` and explains why Apple Intelligence can't run, for example when it's switched off.

                @Code(name: "TaskAgent.swift", file: wa-04-taskagent-02.swift)
            }
        }
    }

    @Section(title: "Run the Agentic Loop") {
        @ContentAndMedia {
            The agentic loop lives inside a single call. For one prompt, the model may call several tools, read what each returned, and only then write its reply. You just watch it happen.

            @Image(source: "wa-diagram-loop.png", alt: "The model calls tools and reads their results until it can reply.")
        }

        @Steps {
            @Step {
                Add `send(_:)`, which calls `respond(to:)`. `liveActions` are the actions logged since this turn began; they appear as chips while the model is still working.

                @Code(name: "TaskAgent.swift", file: wa-04-taskagent-03.swift)
            }

            @Step {
                Handle a full context window. The on-device model's context is small, so after a long chat start a fresh session and let the user try again.

                @Code(name: "TaskAgent.swift", file: wa-04-taskagent-04.swift)
            }
        }
    }

    @Section(title: "Build the Chat") {
        @ContentAndMedia {
            The chat shows the user's requests, the agent's replies, and the actions behind each reply.

            @Image(source: "wa-preview-chat-rows.png", alt: "Chat rows with action chips.")
        }

        @Steps {
            @Step {
                Create `AgentPanel.swift` with the row views: the user's bubbles, the agent's replies with their action chips, and the live "Working on it…" row.

                @Code(name: "AgentPanel.swift", file: wa-04-agentpanel-01.swift) {
                    @Image(source: "wa-preview-chat-rows.png", alt: "A user request, the agent’s action chips and reply, and a working indicator.")
                }
            }

            @Step {
                Add `AgentPanel`: suggestions to tap, the message list and a text field. Submitting hides the keyboard so the board stays visible while the agent works.

                @Code(name: "AgentPanel.swift", file: wa-04-agentpanel-02.swift) {
                    @Image(source: "wa-preview-agent-panel.png", alt: "The agent panel with suggested requests and a text field.")
                }
            }
        }
    }

    @Section(title: "Open the Agent from the Board") {
        @ContentAndMedia {
            Show the chat in a half-height sheet that still lets you see and touch the board. That is where the "wow" happens: you watch the agent change the board live.

            @Image(source: "wa-preview-agent-run.png", alt: "The agent changing the board while the chat shows its actions.")
        }

        @Steps {
            @Step {
                In `ContentView`, add an **Ask the Agent** button and present `AgentPanel` with `.presentationBackgroundInteraction`, so the board behind the sheet stays live.

                @Code(name: "ContentView.swift", file: wa-04-contentview-01.swift, previousFile: wa-02-contentview-01.swift) {
                    @Image(source: "wa-preview-agent-sheet.png", alt: "The board with the agent panel open in a half-height sheet.")
                }
            }

            @Step {
                Create the agent next to the workspace and put both in the environment. Run the app on a device with Apple Intelligence and tap "Prioritise the memory leak and show my tasks as a board".

                @Code(name: "WorkspaceAssistantApp.swift", file: wa-04-app-01.swift, previousFile: wa-02-app-01.swift) {
                    @Image(source: "wa-preview-agent-run.png", alt: "The agent has prioritised the memory leak and switched to the board layout.")
                }
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            The user asks for three changes in one sentence. Where does the agent decide to call three tools?

            @Choice(isCorrect: false) {
                In a loop you write in `send(_:)`.

                @Justification(reaction: "Try again!") {
                    `send(_:)` makes a single call to the model.
                }
            }

            @Choice(isCorrect: true) {
                Inside `respond(to:)`, which keeps calling tools until the model is ready to reply.

                @Justification(reaction: "That's right!") {
                    The framework runs the agentic loop for you and feeds each tool result back to the model.
                }
            }

            @Choice(isCorrect: false) {
                In `AgentPanel`, one tool per message.

                @Justification(reaction: "Not quite.") {
                    The view only displays what happened.
                }
            }
        }

        @MultipleChoice {
            Why is the chat a half-height sheet with background interaction?

            @Choice(isCorrect: true) {
                So the audience can watch the board change while the agent works.

                @Justification(reaction: "Correct!") {
                    Seeing the UI change live is what makes an agent feel real.
                }
            }

            @Choice(isCorrect: false) {
                Because the model needs the board to be visible.

                @Justification(reaction: "Try again!") {
                    The model only sees text: the instructions, prompts and tool results.
                }
            }

            @Choice(isCorrect: false) {
                Full-height sheets can't contain text fields.

                @Justification(reaction: "Not quite.") {
                    They can; the choice is about what the user sees.
                }
            }
        }
    }
}
